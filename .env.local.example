# Stripe live-mode secret key (server-side). Only sk_live_... keys are accepted —
# sandbox/test keys are rejected by the checkout route.
# Get one from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_replace_me

# Stripe live publishable key (client-side).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me

# Stripe Pricing Table IDs (client-side), one per product.
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID_PABLO=prctbl_replace_me
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID_EDGE_NEST=prctbl_replace_me
